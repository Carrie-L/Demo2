<?xml version="1.0" encoding="utf-8"?>
<!--
  AdapterViewFlipper 的单个轮播 item：只包含暗词和搜索按钮。
  底部工具按钮固定在 widget_search_tools.xml，禁止放回本布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_hint_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="7dp"
        android:layout_weight="1"
        android:background="@drawable/widget_search_field"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:textColor="#FF342E2A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_search_button"
        android:layout_width="58dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_search_button"
        android:gravity="center"
        android:text="@string/widget_search"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
