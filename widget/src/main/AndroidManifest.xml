<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".provider.SearchToolsWidgetProvider"
            android:exported="true"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_tools_widget_info" />
        </receiver>

        <service
            android:name=".remote.HintRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:process=":widgetProvider" />

        <activity
            android:name=".router.WidgetRouterActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":widgetProvider"
            android:taskAffinity=""
            android:theme="@style/Theme.Demo2.WidgetRouter" />
    </application>

</manifest>
