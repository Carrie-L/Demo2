<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".provider.SearchToolsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 系统专用升级广播：已有组件重绑新版入口，不等待下一小时同步。 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_tools_widget_info" />
        </receiver>

        <service
            android:name=".remote.HintRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 系统能交付组件事件；点击凭本 App 创建的显式 PendingIntent 进入 Provider。
             不对其他 App 开放推进广播，不声明中转 Activity。 -->
    </application>

</manifest>
