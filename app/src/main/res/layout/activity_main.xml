<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FF24211F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_subtitle"
            android:textColor="#FF706A66"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/privacy_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF24211F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/privacy_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/toggle_privacy"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/frequency_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#FF24211F"
                android:textSize="15sp" />

            <Button
                android:id="@+id/frequency_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/toggle_frequency" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mock_database_title"
                android:textColor="#FF24211F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/data_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFF8F5F2"
                android:padding="12dp"
                android:textColor="#FF514B47"
                android:textSize="14sp" />

            <Button
                android:id="@+id/data_initial_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/write_initial_data" />

            <Button
                android:id="@+id/data_changed_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/write_changed_data" />

            <Button
                android:id="@+id/data_duplicate_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/write_duplicate_data" />

            <Button
                android:id="@+id/data_empty_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clear_database" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_page_validation"
                android:textColor="#FF24211F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/open_search_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_search_activation" />

            <Button
                android:id="@+id/open_result_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_empty_result" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
